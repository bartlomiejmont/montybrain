{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick",
  "description": "Quick-capture window: core events only plus the app commands it had before the app ACL was declared; deliberately NOT the agent-run and project-update commands. Saving, closing and resizing go through the app's own commands.",
  "windows": [
    "quick"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-get-state",
    "allow-search",
    "allow-create-project",
    "allow-update-project",
    "allow-archive-project",
    "allow-create-topic",
    "allow-update-topic",
    "allow-delete-topic",
    "allow-add-journal-entry",
    "allow-create-task",
    "allow-update-task",
    "allow-move-task",
    "allow-delete-task",
    "allow-open-url",
    "allow-reveal-path",
    "allow-reveal-vault",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-shortcut",
    "allow-pause-shortcut",
    "allow-set-autostart",
    "allow-quick-close",
    "allow-quick-resize"
  ]
}
