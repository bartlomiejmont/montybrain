{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core events and window dragging, every app command including the agent runs (list_recipes, list_providers, start_run, cancel_run, list_runs), project updates (list_updates, apply_update, undo_update, dismiss_update, edit_update, join_update, set_auto_update, set_update_sources), drift (list_drift, refresh_drift, link_branch, ignore_branch) and waiting items (list_waiting, set_waiting, confirm_waiting). Vault access goes through the app's own commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-get-state",
    "allow-search",
    "allow-create-project",
    "allow-update-project",
    "allow-archive-project",
    "allow-create-topic",
    "allow-update-topic",
    "allow-delete-topic",
    "allow-add-journal-entry",
    "allow-create-task",
    "allow-update-task",
    "allow-move-task",
    "allow-delete-task",
    "allow-open-url",
    "allow-reveal-path",
    "allow-reveal-vault",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-shortcut",
    "allow-pause-shortcut",
    "allow-set-autostart",
    "allow-quick-close",
    "allow-quick-resize",
    "allow-list-recipes",
    "allow-list-providers",
    "allow-start-run",
    "allow-cancel-run",
    "allow-list-runs",
    "allow-list-updates",
    "allow-apply-update",
    "allow-undo-update",
    "allow-dismiss-update",
    "allow-edit-update",
    "allow-join-update",
    "allow-list-drift",
    "allow-refresh-drift",
    "allow-link-branch",
    "allow-ignore-branch",
    "allow-list-waiting",
    "allow-set-waiting",
    "allow-confirm-waiting",
    "allow-set-auto-update",
    "allow-set-update-sources"
  ]
}
